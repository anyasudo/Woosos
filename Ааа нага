void MainWindow::on_okButton_clicked()
{
    QString factorText = ui->factorSpinBox->text().trimmed();
    
    if (factorText.isEmpty() || factorText == "." || !Shield::isValidFactor(factorText)) {
        QMessageBox::warning(this, "Ошибка", "Введите корректный коэффициент (число от 0 до 1).");
        return;
    }
    
    Shield s = collectFormData();
    QString fileName = QFileDialog::getSaveFileName(this, "Сохранить JSON", "", "JSON (*.json)");
    if (fileName.isEmpty()) return;
    s.saveToFile(fileName);
    QMessageBox::information(this, "Готово", "Объект сохранён в JSON.");
}
