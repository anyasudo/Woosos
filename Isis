#ifndef SHIELD_HPP
#define SHIELD_HPP

#include <QString>
#include <QJsonObject>

class Shield
{
public:
    QString name;
    QString description;
    double defenseFactor;
    QString defenseType;

    Shield();
    Shield(const QString& name, const QString& description,
           double defenseFactor, const QString& defenseType);

    QJsonObject toJson() const;
    static Shield fromJson(const QJsonObject& json);

    void saveToFile(const QString& filename) const;
    static Shield loadFromFile(const QString& filename);

    bool isValid() const;
    QString errorMessage() const;
    static bool isValidFactor(const QString& text);
};

#endif // SHIELD_HPP #include "shield.hpp"
#include <QJsonDocument>
#include <QFile>
#include <QIODevice>

Shield::Shield() : defenseFactor(0.0) {}

Shield::Shield(const QString& name, const QString& description,
               double defenseFactor, const QString& defenseType)
    : name(name), description(description),
      defenseFactor(defenseFactor), defenseType(defenseType) {}

QJsonObject Shield::toJson() const
{
    QJsonObject obj;
    obj["name"] = name;
    obj["description"] = description;
    obj["defenseFactor"] = defenseFactor;
    obj["defenseType"] = defenseType;
    return obj;
}

Shield Shield::fromJson(const QJsonObject& json)
{
    Shield s;
    s.name = json["name"].toString();
    s.description = json["description"].toString();
    s.defenseFactor = json["defenseFactor"].toDouble();
    s.defenseType = json["defenseType"].toString();
    return s;
}

void Shield::saveToFile(const QString& filename) const
{
    QFile file(filename);
    if (!file.open(QIODevice::WriteOnly)) return;

    QJsonDocument doc(toJson());
    file.write(doc.toJson());
    file.close();
}

Shield Shield::loadFromFile(const QString& filename)
{
    QFile file(filename);
    if (!file.open(QIODevice::ReadOnly)) return Shield();

    QByteArray data = file.readAll();
    file.close();

    QJsonDocument doc = QJsonDocument::fromJson(data);
    return fromJson(doc.object());
}

bool Shield::isValid() const
{
    if (name.isEmpty()) return false;
    if (description.isEmpty()) return false;
    if (defenseFactor < 0.0 || defenseFactor > 1.0) return false;
    if (defenseType.isEmpty()) return false;
    return true;
}

QString Shield::errorMessage() const
{
    QString errors;
    if (name.isEmpty()) errors += "Название не заполнено; ";
    if (description.isEmpty()) errors += "Описание не заполнено; ";
    if (defenseFactor < 0.0 || defenseFactor > 1.0) errors += "Коэффициент защиты вне диапазона 0-1; ";
    if (defenseType.isEmpty()) errors += "Тип защиты не заполнен; ";
    return errors;
}

bool Shield::isValidFactor(const QString& text)
{
    if (text.isEmpty()) return true;
    bool ok;
    double value = text.toDouble(&ok);
    if (!ok) return false;
    if (value < 0.0) return false;
    if (value > 1.0) return false;
    return true;
}   #ifndef MAINWINDOW_HPP
#define MAINWINDOW_HPP

#include <QMainWindow>
